# Doxygen configuration for the SushiBLAS public API reference.
#
# Scope is include/SushiBLAS minus the quarantine. Unlike SushiRuntime - which
# curates a fluent `api/` subtree and documents the layers beneath it in prose
# only - SushiBLAS has no such split: the engine facade, the tensor and the
# Dispatch seam are all surface a consumer writes against.
#
# `experimental/` is the one exclusion, and it is deliberate. Decision D1
# quarantined the FFT and linalg headers: they are excluded from the umbrella
# header <SushiBLAS/engine.hpp> and their ops are not all defined. A reference
# that listed them would advertise an API that does not link.
#
# Build it with `sb doxygen` (never `doxygen Doxyfile` by hand - see
# docs/CLAUDE.md); output lands in docs/api-site/html and is gitignored.
#
# This file is COMMITTED, and that is the point of it existing. `sb doxygen`
# reads a repo-root Doxyfile and fails without one, so while `Doxyfile` sat in
# .gitignore the command was documented in CLI_GUIDE.md and could not work in a
# fresh checkout. SushiRuntime commits its own for the same reason.
PROJECT_NAME           = "SushiBLAS"
PROJECT_BRIEF          = "SYCL tensor and BLAS engine — C++ API reference"
PROJECT_NUMBER         = "0.1.0"

OUTPUT_DIRECTORY       = docs/api-site
HTML_OUTPUT            = html
GENERATE_HTML          = YES
GENERATE_XML           = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO

# The public headers plus the hand-written landing page. The reference and the
# manual build together, the same arrangement SushiRuntime's Doxyfile sets up.
INPUT                  = docs/api/mainpage.md \
                         include/SushiBLAS
FILE_PATTERNS          = *.hpp *.h *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = docs/api/mainpage.md

# Internal plumbing and the D1 quarantine. `Detail` is this library's spelling
# of the same idea SushiRuntime spells `detail`; both are listed so a header
# that borrows the other convention does not silently leak.
EXCLUDE_PATTERNS       = */detail/* */Detail/* */experimental/*
EXCLUDE_SYMBOLS        = *::Detail *::Detail::* *::detail *::detail::*

# Document what is written; do not invent docs for undocumented symbols, and
# report anything public that lacks one so the site stays honest about its own
# coverage. WARN_AS_ERROR stays NO deliberately: a missing @param should not be
# able to fail a docs build, and the log below is where the debt is read off.
EXTRACT_ALL            = NO
EXTRACT_STATIC         = NO
EXTRACT_PRIVATE        = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO
WARN_LOGFILE           = docs/api-site/doxygen-warnings.log

JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
SORT_MEMBER_DOCS       = YES
ALPHABETICAL_INDEX     = YES
SOURCE_BROWSER         = NO
QUIET                  = YES
