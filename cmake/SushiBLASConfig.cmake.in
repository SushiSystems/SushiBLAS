@PACKAGE_INIT@

# SushiBLASConfig.cmake — what find_package(SushiBLAS) gives a consumer.
#
# The contract is deliberately narrow. A consumer gets the include
# directories, the library, the SYCL headers and the SYCL link options, and
# SushiBLAS::device_code for its units that instantiate a SushiBLAS kernel
# template; no unit of its own compiles for the device unless it asks. It
# does NOT get this project's warning flags, its sanitizer selection, or the
# ISA of the machine that happened to build it; those live on PRIVATE
# targets and never enter the export set (see
# cmake/SushiBLASBuildPolicy.cmake). The floating-point determinism contract still
# travels — but it comes from SushiRuntime, not from here, since
# SushiRuntime::SushiRuntime is a PUBLIC dependency of SushiBLAS::sushiblas.

include(CMakeFindDependencyMacro)

# The public log headers include SushiLog, and the library links it.
if(NOT TARGET SushiLog::SushiLog)
    find_dependency(SushiLog CONFIG)
endif()

# SushiBLAS is a thin head over the runtime: its own kernels depend on
# SushiRuntime::SushiRuntime being resolvable the same way SushiRuntime's own
# package config resolves its SYCL dependency. If the target already exists, this is a no-op.
if(NOT TARGET SushiRuntime::SushiRuntime)
    find_dependency(SushiRuntime CONFIG)
endif()

# The profile and profiling headers include SushiProfiler when the package was built with it.
if("@SB_ENABLE_PROFILER@")
    if(NOT TARGET SushiProfiler::SushiProfiler)
        find_dependency(SushiProfiler CONFIG)
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/SushiBLASTargets.cmake")

# A unit that links SushiBLAS::sushiblas and compiles without -fsycl still includes
# <sycl/sycl.hpp> through the public headers. The export cannot carry the build machine's path
# to it, so SushiBLAS::sycl_headers takes the one beside this consumer's compiler, when the
# toolchain keeps its headers there.
include("${CMAKE_CURRENT_LIST_DIR}/SushiBLASSyclHeaders.cmake")
sushiblas_find_sycl_include_dir(_sb_sycl_include_dir)
if(_sb_sycl_include_dir)
    target_include_directories(SushiBLAS::sycl_headers SYSTEM INTERFACE "${_sb_sycl_include_dir}")
endif()
unset(_sb_sycl_include_dir)

# The header-only modules as targets (SushiBLAS::Geometry, FixedOrderFold, GraphPrimitives), over
# the installed include folder.
include("${CMAKE_CURRENT_LIST_DIR}/SushiBLASHeaderModules.cmake")
sushiblas_declare_header_modules()

check_required_components(SushiBLAS)
