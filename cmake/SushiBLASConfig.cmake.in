@PACKAGE_INIT@

# SushiBLASConfig.cmake — what find_package(SushiBLAS) gives a consumer.
#
# The contract is deliberately narrow. A consumer gets the include
# directories and the library. It does NOT get this project's warning flags,
# its sanitizer selection, or the ISA of the machine that happened to build
# it; those live on PRIVATE targets and never enter the export set (see
# cmake/SushiBLASBuildPolicy.cmake). The floating-point determinism contract still
# travels — but it comes from SushiRuntime, not from here, since
# SushiRuntime::SushiRuntime is a PUBLIC dependency of SushiBLAS::sushiblas.

include(CMakeFindDependencyMacro)

# The public log headers include SushiLog, and the library links it.
if(NOT TARGET SushiLog::SushiLog)
    find_dependency(SushiLog CONFIG)
endif()

# SushiBLAS is a thin head over the runtime: its own kernels depend on
# SushiRuntime::SushiRuntime being resolvable the same way SushiRuntime's own
# package config resolves its SYCL dependency. If a superproject already
# defined the target (D3's TARGET-guard case), this is a no-op.
if(NOT TARGET SushiRuntime::SushiRuntime)
    find_dependency(SushiRuntime)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/SushiBLASTargets.cmake")

check_required_components(SushiBLAS)
