/**
 * @file profile_config.hpp
 * @brief States the profiler settings this build was configured with.
 * @author Mustafa Garip
 * @see modules/foundation/profile/README.md
 *
 * Generated by `configure_file` from `profile_config.hpp.in`; edit the template, not this file.
 */

#pragma once

/** @brief Whether SushiBLAS is built with SushiProfiler; 0 compiles every macro out. */
#cmakedefine01 SB_ENABLE_PROFILER

/**
 * @brief The deepest zone level a translation unit compiles in: 0 none, 1 stages, 2 fine zones,
 *        3 per-element zones.
 */
#define SB_PROFILE_LEVEL @SB_PROFILE_LEVEL@
